# Copie para `.env.local` (Next) e `.env` (Drizzle) e preencha os valores.
# NÃO comite arquivos .env reais.

# Supabase — em desenvolvimento local (`supabase start`) a CLI imprime estes valores.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole-a-anon-key-do-supabase-start"

# Conexão direta com o Postgres (Drizzle migrations/seed).
# Local (supabase start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Domínio institucional permitido no cadastro (ver regras de negócio).
NEXT_PUBLIC_UNISANTA_EMAIL_DOMAIN="unisanta.br"
