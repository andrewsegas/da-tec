# Variáveis do deploy na VPS. `deploy/setup.sh` copia este arquivo para
# `deploy/.env` e gera todos os segredos automaticamente.
# NUNCA comite o deploy/.env real.

# Domínio público (precisa apontar para a VPS; o Traefik emite o certificado).
DOMAIN=srv2087596.hstgr.cloud

# Domínio institucional aceito no cadastro. Se mudar, ajuste também a
# função `is_signup_email_allowed` (migration 0011_signup_gate).
UNISANTA_EMAIL_DOMAIN=unisanta.br

# Fase de testes: impede indexação. Na versão oficial, troque por "all".
ROBOTS_TAG="noindex, nofollow"

# --- Segredos (gerados por setup.sh) ----------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
PG_META_CRYPTO_KEY=
JWT_EXPIRY=3600

# Studio (só via túnel SSH — veja deploy/README.md)
DASHBOARD_USERNAME=datec
DASHBOARD_PASSWORD=

# --- E-mail (SMTP) ------------------------------------------------------------
# Sem SMTP, o cadastro é confirmado na hora (ENABLE_EMAIL_AUTOCONFIRM=true).
# Com SMTP configurado, troque para false para exigir confirmação por e-mail.
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=nao-responda@example.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=da-tec
