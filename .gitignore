# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# deploy (gerados na VPS — segredos, dados e arquivos baixados do Supabase)
!deploy/.env.example
/deploy/supabase/
/deploy/data/
/deploy/backups/

# vercel
.vercel

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# supabase (arquivos locais/temporários)
/supabase/.branches/
/supabase/.temp/
/supabase/.env

# typescript
*.tsbuildinfo
next-env.d.ts
